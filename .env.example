# Copie este archivo como ".env" (en la raiz del backend) y complete los valores.
# El archivo .env esta en .gitignore: NUNCA se sube al repositorio.

# Conexion a PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/tecno_uam_prestamos
DB_USERNAME=postgres
DB_PASSWORD=escriba_aqui_su_contrasena_de_postgres

# Secreto para firmar los JWT (HS256). Minimo 32 caracteres aleatorios.
# Generar uno en PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=reemplace_por_un_secreto_aleatorio_de_al_menos_32_caracteres

# Opcionales
# SERVER_PORT=8081
# JWT_EXPIRATION_MS=3600000
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# APP_ADMIN_PASSWORD=Admin123*
# APP_USER_PASSWORD=Usuario123*
