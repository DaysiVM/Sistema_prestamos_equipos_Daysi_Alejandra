{
  "info": {
    "_postman_id": "bc0a8e8b-c6cd-56b6-a553-ffbd161297ae",
    "name": "TecnoUAM - Préstamo de equipos (API REST + JWT)",
    "description": "Colección de pruebas del examen práctico integrador. Ejecutar en orden con el Collection Runner. Cada solicitud verifica automáticamente el código HTTP esperado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fechas dinámicas (yyyy-MM-dd) usadas en los préstamos",
          "const f = (d) => d.toISOString().slice(0, 10);",
          "const hoy = new Date();",
          "pm.collectionVariables.set('hoy', f(hoy));",
          "pm.collectionVariables.set('ayer', f(new Date(hoy.getTime() - 86400000)));",
          "pm.collectionVariables.set('enUnaSemana', f(new Date(hoy.getTime() + 7 * 86400000)));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Autenticación (login y JWT)",
      "item": [
        {
          "name": "Login ADMIN (guarda adminToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Devuelve un JWT con rol ADMIN\", function () {",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(json.rol).to.eql(\"ADMIN\");",
                  "});",
                  "pm.collectionVariables.set(\"adminToken\", json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login USER (guarda userToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"usuario\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Devuelve un JWT con rol USER\", function () {",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(json.rol).to.eql(\"USER\");",
                  "});",
                  "pm.collectionVariables.set(\"userToken\", json.token);"
                ]
